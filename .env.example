# --- Deploy (docker compose) ---
# Your server's hostname. No domain? Use sslip.io: 203.0.113.7 -> 203-0-113-7.sslip.io
SITE_HOST=
# For node deploy/vultr.mjs (Vultr → Account → API)
VULTR_API_KEY=
DB_PASSWORD=
# --- App ---
PORT=3000
PUBLIC_URL=http://localhost:3000
DEMO=1
DATABASE_URL=
# Our own model on Vultr (Ollama/vLLM on a Vultr GPU, or Vultr Serverless Inference). OpenAI-compatible.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=3000
# Fallback if the self-hosted model is unset or down
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Hardware Switch (Arduino). Unset in demo mode means "demo-switch".
SWITCH_KEY=
# NFC tag UID(s) that end the night, comma-separated. Unset in demo mode means any tag.
SWITCH_HOME_TAG=
