      "type": "timeseries",
      "title": "Check-ins per night",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT s.armed_at AS time, count(*) FILTER (WHERE e.kind = 'checkin_ack') AS \"answered\", count(*) FILTER (WHERE e.kind = 'level_change' AND e.detail->>'to' = 'ALARM') AS \"missed\" FROM events e JOIN sessions s ON s.id = e.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND $__timeFilter(s.armed_at) GROUP BY s.armed_at ORDER BY 1"
        }
      ],
