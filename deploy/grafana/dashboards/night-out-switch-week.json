                },
                "CONTACT": {
                  "color": "#C2121F",
                  "index": 3,
                  "text": "Contact alerted"
                },
                "WIDER": {
                  "color": "#7A0B14",
                  "index": 4
                },
                "RESOLVED": {
                  "color": "#E4E6EF",
                  "index": 5,
                  "text": "Home"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sound across the week (10-minute buckets from metrics_1m)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('10 minutes', m.bucket) AS time, avg(m.avg) AS \"average dB\" FROM metrics_1m m JOIN sessions s ON s.id = m.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND m.metric = 'sound_db' AND $__timeFilter(m.bucket) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('10 minutes', m.bucket) AS time, max(m.max) AS \"peak dB\" FROM metrics_1m m JOIN sessions s ON s.id = m.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND m.metric = 'sound_peak_db' AND $__timeFilter(m.bucket) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "barAlignment": 0,
            "spanNulls": false,
            "insertNulls": 1800000,
            "barWidthFactor": 0.5
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "dB"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "How loud each hour of the night gets",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(make_time(h::int, 0, 0), 'HH24:MI') AS \"hour\", round(avg_db::numeric, 1) AS \"average dB\" FROM (SELECT extract(hour FROM m.bucket AT TIME ZONE 'America/Toronto') AS h, avg(m.avg) AS avg_db FROM metrics_1m m JOIN sessions s ON s.id = m.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND m.metric = 'sound_db' AND $__timeFilter(m.bucket) GROUP BY 1) x ORDER BY (h::int + 6) % 24"
        }
      ],
      "options": {
        "orientation": "vertical",
        "xField": "hour",
        "showValue": "never",
        "barWidth": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2F45FF"
          },
          "unit": "dB",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
