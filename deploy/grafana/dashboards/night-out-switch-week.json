            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(make_time(h::int, 0, 0), 'HH12 AM') AS \"hour\", round((avg_db + 60)::numeric, 1) AS \"Loudness\" FROM ( SELECT extract(hour FROM m.bucket AT TIME ZONE 'America/Toronto') AS h, avg(m.avg) AS avg_db FROM metrics_1m m JOIN sessions s ON s.id = m.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND m.metric = 'sound_db' AND $__timeFilter(m.bucket) GROUP BY 1) x ORDER BY (h + 12)::int % 24"
        }
      ],
      "description": "Average dB above a quiet room (-60 dB), by hour.",
