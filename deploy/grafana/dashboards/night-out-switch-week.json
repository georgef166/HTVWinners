          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(m.value) AS value FROM metrics m JOIN sessions s ON s.id = m.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND m.metric = 'reply_s' AND $__timeFilter(m.time)"
