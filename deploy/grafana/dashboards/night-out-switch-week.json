    {
      "id": 7,
      "type": "state-timeline",
      "title": "The escalation ladder, every night",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT e.time, e.detail->>'to' AS \"level\" FROM events e JOIN sessions s ON s.id = e.session_id WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND e.kind = 'level_change' AND $__timeFilter(e.time) ORDER BY e.time"
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "ARMED": {
                  "color": "#2F45FF",
                  "index": 0,
                  "text": "Armed"
                },
                "NUDGE": {
                  "color": "#FF9500",
                  "index": 1,
