            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(s.armed_at AT TIME ZONE 'America/Toronto', 'Dy Mon DD, HH12:MI AM') AS \"Night\", round((EXTRACT(EPOCH FROM coalesce(s.resolved_at, now()) - s.armed_at) / 3600)::numeric, 1) AS \"Hours\", (SELECT count(*) FROM events e WHERE e.session_id = s.id AND e.kind = 'checkin_ack') AS \"Check-ins\", (SELECT round(avg(value)::numeric, 1) FROM metrics WHERE session_id = s.id AND metric = 'reply_s') AS \"Avg reply (s)\", (SELECT count(*) FROM events e WHERE e.session_id = s.id AND e.kind = 'level_change' AND e.detail->>'to' = 'ALARM') AS \"Alarms\", (SELECT round(max(value)::numeric, 1) FROM metrics WHERE session_id = s.id AND metric = 'distress_score') AS \"Danger score\", (SELECT round(min(value)::numeric, 1) FROM metrics WHERE session_id = s.id AND metric = 'temp_c') AS \"Coldest (\u00b0C)\", (SELECT value FROM metrics WHERE session_id = s.id AND metric = 'battery_pct' ORDER BY time DESC LIMIT 1) AS \"Battery home (%)\" FROM sessions s WHERE s.user_name = '$person' AND s.checkin_every_s >= 300 AND $__timeFilter(s.armed_at) ORDER BY s.armed_at DESC"
        }
