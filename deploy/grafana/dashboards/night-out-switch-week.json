      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "person",
        "label": "Person",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tiger"
        },
        "query": "SELECT DISTINCT user_name FROM sessions WHERE checkin_every_s >= 300 ORDER BY 1",
        "refresh": 1,
        "current": {
          "text": "Maya",
          "value": "Maya"
        },
        "includeAll": false,
        "multi": false
      }
    ]
