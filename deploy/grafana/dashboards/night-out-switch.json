      "title": "Escalation ladder",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "description": "Each step of the night: armed, check-in, alarm, contact alerted.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, detail->>'to' AS \"level\" FROM events WHERE session_id = '$session' AND kind = 'level_change' AND $__timeFilter(time) ORDER BY time"
        }
      ],
      "options": {
