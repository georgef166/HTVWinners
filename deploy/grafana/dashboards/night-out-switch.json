    {
      "type": "timeseries",
      "title": "Sound anomaly (z-score)",
      "description": "Each reading against its own rolling baseline. Above 2 is unusual for this night.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, (value - avg(value) OVER w) / NULLIF(stddev_samp(value) OVER w, 0) AS \"z-score\" FROM metrics WHERE session_id = '$session' AND metric = 'sound_db' AND $__timeFilter(time) WINDOW w AS (ORDER BY time ROWS BETWEEN 30 PRECEDING AND CURRENT ROW) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
