    {
      "id": 6,
      "type": "timeseries",
      "title": "Sound around her (dB, loudness only)",
      "description": "time_bucket over the metrics hypertable",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('5 seconds', time) AS time, avg(value) AS \"average\" FROM metrics WHERE session_id = '$session' AND metric = 'sound_db' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('5 seconds', time) AS time, max(value) AS \"peak\" FROM metrics WHERE session_id = '$session' AND metric = 'sound_peak_db' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "pointSize": 7,
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "dB"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
