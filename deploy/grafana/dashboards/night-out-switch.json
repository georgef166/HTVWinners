    {
      "type": "table",
      "title": "What happened tonight",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time AS \"Time\", CASE kind WHEN 'checkin_sent' THEN 'Check-in sent' WHEN 'checkin_ack' THEN 'Checked in' WHEN 'stand_down' THEN 'PIN cancelled the alarm' WHEN 'contact_ack' THEN 'Contact is on it' WHEN 'danger_alert' THEN 'Danger heard, contact alerted' WHEN 'distress_check' THEN 'Danger check' WHEN 'level_change' THEN 'Level: ' || initcap(detail->>'to') WHEN 'device' THEN 'Switch: ' || coalesce(detail->>'type', '') WHEN 'resolved' THEN 'Night ended' ELSE kind END AS \"What\" FROM events WHERE session_id = '$session' AND kind NOT IN ('heartbeat', 'summary') AND NOT (kind = 'device' AND detail->>'type' = 'reading') AND $__timeFilter(time) ORDER BY time DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
