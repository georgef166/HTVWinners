    {
      "type": "timeseries",
      "title": "Sound around her",
      "description": "Loudness only, never audio. The red band is where shouting starts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
