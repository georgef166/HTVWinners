            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('5 seconds', time) AS time, avg(value) AS \"average\", max(value) AS \"peak\" FROM metrics WHERE session_id = '$session' AND metric IN ('sound_db', 'sound_peak_db') AND $__timeFilter(time) GROUP BY 1 ORDER BY 1"
