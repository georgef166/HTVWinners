    {
      "id": 8,
      "type": "timeseries",
      "title": "Time-stream analysis: sound anomaly (z-score vs rolling baseline)",
      "description": "How unusual each peak is compared with the last 20 readings. Above 2 is a spike worth a 30-second check.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, (value - avg(value) OVER w) / NULLIF(stddev_samp(value) OVER w, 0) AS \"z-score\", 2 AS \"flag line\" FROM metrics WHERE session_id = '$session' AND metric = 'sound_peak_db' AND $__timeFilter(time) WINDOW w AS (ORDER BY time ROWS BETWEEN 20 PRECEDING AND CURRENT ROW) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "pointSize": 7,
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF4D3D"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
