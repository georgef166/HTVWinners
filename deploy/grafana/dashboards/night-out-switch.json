  "templating": {
    "list": [
      {
        "name": "session",
        "label": "Night",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tiger"
        },
        "query": "SELECT user_name || ' (' || to_char(armed_at AT TIME ZONE 'America/Toronto', 'Mon DD HH24:MI') || ')' AS __text, id::text AS __value FROM sessions ORDER BY armed_at DESC LIMIT 50",
        "definition": "sessions",
        "refresh": 2,
        "current": {},
        "includeAll": false,
        "multi": false,
        "sort": 0
      }
    ]
  },
  "panels": [
