        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Night Out Switch: one night, as a time series\nSignals from the phone and the Switch, stored in **Tiger Data** (hypertables `events` and `metrics`, compressed after a day, deleted after 7). Audio is never stored: only the score of a 30-second check."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Out for",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tiger"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tiger"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT now() - armed_at AS value FROM sessions WHERE id = '$session'"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
