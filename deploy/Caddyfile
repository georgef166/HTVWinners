# Our http:// block below does the HTTP-to-HTTPS redirects itself, so it can leave /api/switch/* on plain HTTP.
{
	auto_https disable_redirects
}

# HTTPS for phones (location and battery need a secure page). SITE_HOST comes from .env; ALT_HOSTS lists other
# names served the same way (www, and the old sslip.io address so existing links and QR codes keep working).
{$SITE_HOST} {$ALT_HOSTS} {
	encode gzip
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy app:3000
	}
}

# Plain HTTP only for the Arduino Switch (its firmware speaks HTTP), on any name; everything else redirects to HTTPS.
http:// {
	@switch path /api/switch/*
	handle @switch {
		reverse_proxy app:3000
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
